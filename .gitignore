# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/out-pages/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Claude Code (configuración local)
.claude/settings.local.json
# Skills de terceros: se reinstalan desde skills-lock.json
.claude/skills/

# Informe de investigación: solo local. La bitácora sí se versiona.
/doc/*
!/doc/bitacora.md
!/doc/creditos.md
# Registro de hallazgos (T-101, DR-04); los paquetes de auditoría siguen fuera de Git.
!/doc/registro-hallazgos.md
# Expediente de lanzamiento (T-117), plan de medición (T-118) y protocolo de accesibilidad (T-109)
!/doc/expediente-lanzamiento.md
!/doc/plan-medicion.md
!/doc/protocolo-accesibilidad.md
!/doc/skills-candidatas/

# Playwright
/test-results/
/playwright-report/

# Originales de las fotos (pesados): solo se publican las versiones optimizadas de public/images/
/fotos-originales/

# Resumen de Lighthouse (LH_SALIDA en CI, T-85)
/lighthouse-resumen.json

# Artefactos locales de revisión (capturas, logs, sondas): no se versionan ni se borran (T-114, DR-12)
/output/

# Lighthouse con su propio lock (T-113): se versionan package.json y package-lock.json
/tools/lighthouse/node_modules/

# Mapas de profundidad del hero: entorno de Python y modelo ONNX descargado (solo local).
/tools/profundidad/.venv/
/tools/profundidad/modelos/
__pycache__/
